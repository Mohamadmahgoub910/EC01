@* @model IEnumerable<Brand> *@
<div class="container">
    <div class="display-5">
        @* @Context.Request.Cookies["Notifcation"] *@
        @TempData["Notifcation"]
    </div>
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All brands</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Admin/Brand/Create" class="btn btn-success">Create</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
                </thead>
                <tbody>
                <!-- Example static rows for training -->
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.Name</td>
                        <td>
                            <span class="@(item.Status ? "badge text-bg-success" : "badge text-bg-danger")">
                                @(item.Status ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a href="/Admin/Brand/Edit/@item.Id" class="btn btn-warning">Edit</a>
                            <a href="/Admin/Brand/Delete/@item.Id" class="btn btn-danger btn-delete">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- SweetAlert script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();

                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Are you sure?",
                    text: "This action cannot be undone!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {

                        Swal.fire({
                            title: "Deleted!",
                            text: "Your record has been deleted.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });

                        // هنا بيتم التحويل فعليًا للأكشن اللي بيعمل الدليت في السيرفر
                        setTimeout(() => {
                            window.location.href = url;
                        }, 1500);
                    }
                });
            });
        });
    });
</script>
